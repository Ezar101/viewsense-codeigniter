{
  "name": "viewsense-codeigniter",
  "displayName": "ViewSense for CodeIgniter",
  "description": "Knows the variables your controllers pass to your CodeIgniter 3 and 4 views, and their types.",
  "version": "0.0.0",
  "private": true,
  "publisher": "ezar101",
  "license": "MIT",
  "author": "Ezar Affandi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ezar101/viewsense-codeigniter.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/Ezar101/viewsense-codeigniter/issues"
  },
  "homepage": "https://github.com/Ezar101/viewsense-codeigniter#readme",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "codeigniter",
    "codeigniter3",
    "codeigniter4",
    "php",
    "views"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "ViewSense reads the project files from disk."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "viewsense.updateViewHints",
        "title": "Update View Hints",
        "category": "ViewSense"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".viewsense.json",
        "url": "./schemas/viewsense.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --production",
    "prelaunch": "node esbuild.mjs && node scripts/prepare-sandbox.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "php-parser": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild": false
  }
}
