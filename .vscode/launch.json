{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run extension on CodeIgniter 3 sandbox",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode",
        "${workspaceFolder}/vscode/.sandbox/ci3"
      ],
      "outFiles": ["${workspaceFolder}/vscode/dist/**/*.js"],
      "preLaunchTask": "npm: prelaunch - vscode"
    },
    {
      "name": "Run extension on CodeIgniter 4 sandbox",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode",
        "${workspaceFolder}/vscode/.sandbox/ci4"
      ],
      "outFiles": ["${workspaceFolder}/vscode/dist/**/*.js"],
      "preLaunchTask": "npm: prelaunch - vscode"
    }
  ]
}
